<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical">

    <app.simple.felicity.decorations.equalizer.FelicityEqualizer
        android:id="@+id/equalizer_sliders"
        android:layout_width="match_parent"
        android:paddingHorizontal="@dimen/padding_15"
        android:layout_weight="1"
        android:layout_height="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/padding_10"
        android:paddingHorizontal="@dimen/padding_20"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.highlight.HighlightTextView
            android:id="@+id/preset_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_10"
            android:paddingVertical="@dimen/padding_5"
            android:text="@string/presets"
            app:appFontStyle="bold"
            app:highlightMode="auto"
            app:textColorStyle="secondary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/eq_menu"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:src="@drawable/ic_menu"
            app:buttonTintType="regular" />

    </LinearLayout>

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_marginHorizontal="@dimen/padding_20"
        android:layout_marginVertical="@dimen/padding_10"
        android:layout_height="1px" />

    <app.simple.felicity.decorations.equalizer.EqualizerWaveView
        android:id="@+id/equalizer_wave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eq_preset_preview_height"
        android:layout_marginHorizontal="@dimen/padding_10"
        android:layout_marginBottom="@dimen/padding_15" />

</LinearLayout>