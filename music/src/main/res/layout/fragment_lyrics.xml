<?xml version="1.0" encoding="utf-8"?>
<app.simple.felicity.decorations.theme.ThemeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:layout_height="match_parent"
    app:navigationPaddingRequired="true"
    app:statusPaddingRequired="false">

    <ImageView
        android:id="@+id/cover"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <app.simple.felicity.decorations.padding.NonThemePaddingAwareLinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_20"
        android:layout_height="match_parent"
        app:navigationPaddingRequired="true"
        app:statusPaddingRequired="false">

        <app.simple.felicity.decorations.lrc.view.FelicityLrcView
            android:id="@+id/lrc"
            android:layout_width="match_parent"
            android:paddingHorizontal="@dimen/padding_5"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/padding_10"
            android:layout_marginTop="@dimen/padding_10">

            <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                android:id="@+id/settings"
                android:layout_width="@dimen/button_size"
                android:src="@drawable/ic_menu"
                android:layout_marginEnd="@dimen/padding_1"
                android:layout_height="@dimen/button_size" />

            <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                android:id="@+id/search"
                android:layout_width="@dimen/button_size"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="@dimen/padding_1"
                android:layout_height="@dimen/button_size" />

            <app.simple.felicity.decorations.theme.ThemeDivider
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/padding_10"
                android:layout_gravity="center_vertical"
                android:layout_height="1px" />

            <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                android:id="@+id/previous"
                android:layout_width="@dimen/button_size"
                android:src="@drawable/ic_skip_previous"
                android:layout_marginEnd="@dimen/padding_1"
                android:layout_height="@dimen/button_size" />

            <app.simple.felicity.decorations.views.PlayButton
                android:id="@+id/play"
                android:layout_width="@dimen/button_size"
                android:layout_height="@dimen/button_size"
                android:layout_marginEnd="@dimen/padding_1"
                android:padding="@dimen/padding_10"
                app:buttonTintType="regular" />

            <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
                android:id="@+id/next"
                android:layout_width="@dimen/button_size"
                android:src="@drawable/ic_skip_next"
                android:layout_height="@dimen/button_size" />

        </LinearLayout>

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="@dimen/padding_5"
            android:ellipsize="end"
            android:layout_marginHorizontal="@dimen/padding_10"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="@dimen/text_size_18"
            app:appFontStyle="bold"
            app:drawableTintStyle="custom"
            app:layout_constraintBottom_toTopOf="@+id/artists"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cover"
            app:layout_constraintTop_toTopOf="@+id/cover"
            app:layout_constraintVertical_chainStyle="packed"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/artists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/text_size_14"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="@dimen/padding_10"
            android:gravity="center"
            app:appFontStyle="medium"
            app:layout_constraintBottom_toBottomOf="@+id/cover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cover"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:textColorStyle="accent" />

        <app.simple.felicity.decorations.seekbars.WaveformSeekbar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="center_vertical"
            app:wsbBarWidth="6dp"
            app:wsbLabelGravity="center"
            app:wsbLabelHighlightMode="both"
            app:wsbWaveformMode="full" />

    </app.simple.felicity.decorations.padding.NonThemePaddingAwareLinearLayout>

</app.simple.felicity.decorations.theme.ThemeFrameLayout>