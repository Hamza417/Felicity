<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:animateLayoutChanges="true"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_15"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_36"
            android:text="@string/app_name"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:layout_gravity="center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            app:appFontStyle="black"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/search"
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:src="@drawable/ic_search" />

        <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/server_toggle"
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:src="@drawable/ic_wifi" />

        <app.simple.felicity.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/menu"
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/padding_5"
        android:scrollbars="none"
        android:visibility="gone"
        android:fadingEdge="horizontal"
        android:animateLayoutChanges="true"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="@dimen/padding_20"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Library stats chip: shows total track count and total hours -->
            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/library_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:layout_marginStart="@dimen/padding_15"
                android:maxWidth="250dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:maxLines="1"
                android:drawableStart="@drawable/ic_pie_16dp"
                android:drawablePadding="@dimen/padding_5"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/active_queue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:layout_marginStart="@dimen/padding_8"
                android:maxWidth="250dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:maxLines="1"
                android:drawableStart="@drawable/ic_queue_16dp"
                android:drawablePadding="@dimen/padding_5"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/sleep_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:layout_marginStart="@dimen/padding_8"
                android:drawableStart="@drawable/ic_timer_16dp"
                android:drawablePadding="@dimen/padding_5"
                android:textSize="@dimen/text_size_14"
                android:visibility="gone"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

            <!-- Server active chip: only visible while the Wi-Fi server is running -->
            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/server_active_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_8"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:drawableStart="@drawable/ic_wifi_16dp"
                android:drawablePadding="@dimen/padding_5"
                android:text="@string/server_active"
                android:textSize="@dimen/text_size_14"
                android:singleLine="true"
                android:visibility="gone"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_8"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:drawableStart="@drawable/ic_cloud_16dp"
                android:drawablePadding="@dimen/padding_5"
                android:text="@string/weather_effect"
                android:textSize="@dimen/text_size_14"
                android:singleLine="true"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

            <app.simple.felicity.decorations.highlight.HighlightTextView
                android:id="@+id/grid_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/padding_5"
                android:paddingHorizontal="@dimen/padding_10"
                android:layout_marginStart="@dimen/padding_8"
                android:layout_marginEnd="@dimen/padding_15"
                android:drawablePadding="@dimen/padding_5"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:drawableTintStyle="accent"
                app:highlightMode="outline"
                app:textColorStyle="secondary" />

        </LinearLayout>

    </HorizontalScrollView>

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/padding_10"
        android:layout_height="1px" />

</LinearLayout>