<?xml version="1.0" encoding="utf-8"?>
<app.simple.felicity.decorations.corners.DynamicCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_15"
        android:text="@string/replace_queue_title"
        android:textSize="@dimen/text_size_16"
        app:appFontStyle="bold"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_10">

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_10"
            android:paddingTop="@dimen/padding_5"
            android:paddingBottom="@dimen/padding_5"
            android:text="@string/for_this_song_only"
            android:textSize="@dimen/text_size_12"
            app:appFontStyle="bold"
            app:textColorStyle="secondary" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/playNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/padding_10"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_10"
            android:text="@string/play_next"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableStartCompat="@drawable/ic_skip_next_menu_16dp"
            app:drawableTintStyle="regular"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/addToQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/padding_10"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_10"
            android:text="@string/add_to_queue"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableStartCompat="@drawable/ic_queue_16dp"
            app:drawableTintStyle="regular"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.theme.ThemeDivider
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginVertical="@dimen/padding_5" />

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_10"
            android:paddingTop="@dimen/padding_5"
            android:paddingBottom="@dimen/padding_5"
            android:text="@string/for_the_queue"
            android:textSize="@dimen/text_size_12"
            app:appFontStyle="bold"
            app:textColorStyle="secondary" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/moveToEmptyQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/padding_10"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_10"
            android:text="@string/move_to_empty_queue"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableStartCompat="@drawable/ic_folder_16dp"
            app:drawableTintStyle="regular"
            app:textColorStyle="primary" />

        <app.simple.felicity.decorations.ripple.DynamicRippleTextView
            android:id="@+id/replace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/padding_10"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_10"
            android:text="@string/replace"
            android:textSize="@dimen/text_size_14"
            app:appFontStyle="bold"
            app:drawableStartCompat="@drawable/ic_swap_16dp"
            app:drawableTintStyle="regular"
            app:textColorStyle="primary" />

    </LinearLayout>

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_10"
        android:padding="@dimen/padding_10"
        android:text="@string/replace_queue_message"
        android:textSize="@dimen/text_size_12"
        app:appFontStyle="regular"
        app:textColorStyle="tertiary" />

</app.simple.felicity.decorations.corners.DynamicCornerLinearLayout>
