<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:padding="@dimen/dialog_padding"
    android:layout_height="wrap_content">

    <app.simple.felicity.decorations.corners.DynamicCornerLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:padding="@dimen/dialog_padding">

        <app.simple.felicity.decorations.views.RollingTimePicker
            android:id="@+id/time_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:id="@+id/presets_scroll"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/padding_15"
            android:layout_marginBottom="@dimen/padding_5"
            android:scrollbars="none"
            android:clipToPadding="true"
            android:paddingHorizontal="@dimen/padding_15"
            android:fadingEdge="horizontal"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="@dimen/padding_20"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_15m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_30m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:layout_marginStart="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_45m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:layout_marginStart="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_1h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:layout_marginStart="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_2h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:layout_marginStart="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

                <app.simple.felicity.decorations.highlight.HighlightTextView
                    android:id="@+id/preset_3h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/padding_5"
                    android:paddingHorizontal="@dimen/padding_10"
                    android:layout_marginStart="@dimen/padding_10"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="tertiary" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/sync_adjust_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_15"
                android:orientation="vertical">

                <app.simple.felicity.decorations.typeface.TypeFaceTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/final_action"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/text_size_14"
                    app:appFontStyle="bold"
                    app:textColorStyle="primary" />

                <app.simple.felicity.decorations.typeface.TypeFaceTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/final_action_summary"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/text_size_12"
                    app:appFontStyle="regular"
                    app:textColorStyle="accent" />

            </LinearLayout>

            <app.simple.felicity.decorations.toggles.FelicityButtonGroup
                android:id="@+id/final_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/padding_15"
            android:gravity="end">

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                android:id="@+id/till_this_son"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_15"
                android:text="@string/till_this_song"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:textColorStyle="secondary" />

            <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                android:id="@+id/start_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_10"
                android:padding="@dimen/padding_15"
                android:text="@string/start"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:textColorStyle="accent" />

            <app.simple.felicity.decorations.ripple.DynamicRippleTextView
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_10"
                android:padding="@dimen/padding_15"
                android:text="@string/stop"
                android:visibility="gone"
                android:textSize="@dimen/text_size_14"
                app:appFontStyle="bold"
                app:textColorStyle="accent" />

        </LinearLayout>

    </app.simple.felicity.decorations.corners.DynamicCornerLinearLayout>


</FrameLayout>