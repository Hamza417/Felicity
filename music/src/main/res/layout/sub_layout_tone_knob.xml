<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_marginBottom="@dimen/padding_15">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/eq_mid_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <app.simple.felicity.decorations.knobs.FelicityKnobView
        android:id="@+id/bass_knob"
        android:layout_width="@dimen/optimal_knob_dimension"
        android:layout_height="@dimen/optimal_knob_dimension"
        app:layout_constraintEnd_toStartOf="@+id/eq_mid_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_12"
        android:text="@string/bass"
        android:gravity="center"
        android:ellipsize="marquee"
        android:layout_marginTop="@dimen/padding_10"
        android:maxLines="1"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:appFontStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/eq_mid_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bass_knob"
        app:textColorStyle="heading" />

    <app.simple.felicity.decorations.knobs.FelicityKnobView
        android:id="@+id/treble_knob"
        android:layout_width="@dimen/optimal_knob_dimension"
        android:layout_height="@dimen/optimal_knob_dimension"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/eq_mid_guideline"
        app:layout_constraintTop_toTopOf="parent" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_12"
        android:gravity="center"
        android:ellipsize="marquee"
        android:layout_marginTop="@dimen/padding_10"
        android:maxLines="1"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:text="@string/treble"
        app:appFontStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/eq_mid_guideline"
        app:layout_constraintTop_toBottomOf="@+id/treble_knob"
        app:textColorStyle="heading" />

</androidx.constraintlayout.widget.ConstraintLayout>