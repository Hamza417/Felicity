<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <app.simple.felicity.decorations.knobs.FelicityKnobView
        android:id="@+id/volumeKnob"
        android:layout_width="@dimen/volume_knob_dimension"
        android:layout_height="@dimen/volume_knob_dimension"
        android:layout_gravity="center" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_12"
        android:text="@string/volume"
        android:gravity="center"
        android:layout_gravity="center"
        android:ellipsize="marquee"
        android:layout_marginTop="@dimen/padding_10"
        android:maxLines="1"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:appFontStyle="bold"
        app:textColorStyle="heading" />

</LinearLayout>