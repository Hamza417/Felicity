<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/padding_15">

    <app.simple.felicity.decorations.corners.DynamicCornerLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_20">

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/colorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_bar_lyrics_text_color"
            android:textSize="@dimen/text_size_18"
            app:appFontStyle="bold"
            app:textColorStyle="primary" />

        <!-- The colour wheel keeps itself square (ColorPickerView.onMeasure). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/color_picker_wheel_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/padding_15">

            <app.simple.inure.decorations.colorpicker.ColorPickerView
                android:id="@+id/colorPicker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- HSV value: dragging to 0 gives true black, which the hue/sat wheel alone cannot reach. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_15"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_bar_lyrics_brightness"
                android:textSize="@dimen/text_size_16"
                app:appFontStyle="regular"
                app:textColorStyle="secondary" />

            <SeekBar
                android:id="@+id/brightnessSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_10"
                android:layout_weight="1"
                android:max="100" />

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/brightnessValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="@dimen/text_size_16"
                app:appFontStyle="regular"
                app:textColorStyle="secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_bar_lyrics_opacity"
                android:textSize="@dimen/text_size_16"
                app:appFontStyle="regular"
                app:textColorStyle="secondary" />

            <SeekBar
                android:id="@+id/opacitySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_10"
                android:layout_weight="1"
                android:max="100" />

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/opacityValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="@dimen/text_size_16"
                app:appFontStyle="regular"
                app:textColorStyle="secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_15"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/colorPreview"
                android:layout_width="@dimen/color_picker_preview_size"
                android:layout_height="@dimen/color_picker_preview_size" />

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/colorHex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/padding_10"
                android:textSize="@dimen/text_size_16"
                app:appFontStyle="regular"
                app:textColorStyle="secondary" />

        </LinearLayout>

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/colorDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_20"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="@dimen/padding_10"
            android:text="@string/done"
            android:textSize="@dimen/text_size_16"
            app:appFontStyle="bold"
            app:textColorStyle="accent" />

    </app.simple.felicity.decorations.corners.DynamicCornerLinearLayout>

</FrameLayout>
